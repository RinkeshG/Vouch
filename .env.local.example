# ============================================================
# Vouch — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# Supabase (required for auth + database)
# Get these from: https://supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (optional — used by OG image data endpoint to bypass RLS)
# Get this from: https://supabase.com → Project → Settings → API → service_role key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Places API (required for restaurant search)
# Get this from: https://console.cloud.google.com → APIs & Services → Credentials
# Make sure "Places API" is enabled under APIs & Services → Library
# Use EITHER name — both are checked by the server route:
GOOGLE_PLACES_API_KEY=your-google-api-key
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-api-key

# OG Image internal secret (optional, defaults to "og-internal" in dev)
# Set a random string in production for security
# OG_INTERNAL_SECRET=your-random-secret
