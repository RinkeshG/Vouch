{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/p/:handle/:list",
      "destination": "/api/profile-preview?handle=:handle&list=:list"
    },
    {
      "source": "/p/:handle",
      "destination": "/api/profile-preview?handle=:handle"
    },
    {
      "source": "/:handle/:list",
      "destination": "/api/profile-preview?handle=:handle&list=:list"
    },
    {
      "source": "/:handle",
      "destination": "/api/profile-preview?handle=:handle"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
