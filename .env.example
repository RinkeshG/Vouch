# Required for cloud sync, public links, and invites.
# Create a free project at https://supabase.com then paste keys here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# After adding keys:
# 1. Run SQL in supabase/schema.sql (Supabase → SQL Editor)
# 2. Enable Authentication → Providers → Anonymous sign-ins
# 3. npm run build && deploy (see DEPLOY.md)
