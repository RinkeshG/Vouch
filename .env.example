# Required for cloud sync, public links, and invites.
# Create a free project at https://supabase.com then paste keys here.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Canonical domain for sharing (WhatsApp previews, pasted links — use your production URL).
# Leave unset locally to fall back to the current browser origin.
# VITE_PUBLIC_SITE_URL=https://vouch.app

# Google Places (search when adding a spot) — server-side on Vercel, or client fallback:
GOOGLE_PLACES_API_KEY=your-google-api-key
# Optional client fallback for local dev:
# VITE_GOOGLE_PLACES_API_KEY=your-google-api-key

# After adding keys:
# 1. Run SQL in supabase/schema.sql (Supabase → SQL Editor)
# 2. Enable Authentication → Providers → Anonymous sign-ins + Email
# 3. Set Site URL / redirect URLs to your deployed origin
# 4. npm run build && deploy (see DEPLOY.md)
